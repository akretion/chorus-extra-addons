<odoo>


<record id="view_move_form" model="ir.ui.view">
    <field name="model">account.move</field>
    <field name="inherit_id" ref="l10n_fr_chorus_account.view_move_form" />
    <field name="arch" type="xml">
        <field name="chorus_service_code" position="after">
            <field name="fr_chorus_service_id" invisible="transmit_method_code != 'fr-chorus'" readonly="state != 'draft'"/>
        </field>
        <field name="chorus_service_code" position="attributes">
            <attribute name="invisible">1</attribute>
        </field>
    </field>
</record>


</odoo>
