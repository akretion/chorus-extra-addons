<odoo>

<record id="view_order_form" model="ir.ui.view">
    <field name="model">sale.order</field>
    <field name="inherit_id" ref="sale.view_order_form"/>
    <field name="arch" type="xml">
        <field name="partner_invoice_id" position="after">
            <field name="service_direct_invoice_transmit_method_code" invisible="1"/>
            <field name="fr_chorus_service_id" invisible="service_direct_invoice_transmit_method_code != 'fr-chorus'"/>
        </field>
    </field>
</record>

</odoo>
